{
  "name": "Easy Youtube Video Downloader Express",
  "description": "No# 1 Rated Youtube Video Downloader for web browsers with MP3 and Full-HD downloads. Instant, one-click Youtube video downloader with high-quality 256Kbps/128Kbps MP3 and Full-HD video downloading options.",
  "manifest_version": 3,
  "version": "26.3",
  "icons": {
    "48": "icons/icon.png"
  },
  "background": {
    "service_worker": "includes/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "includes/page_bridge.js"
      ],
      "matches": [
        "http://www.youtube.com/*",
        "https://www.youtube.com/*",
        "http://m.youtube.com/*"
      ],
      "exclude_matches": [
        "http://www.youtube.com/embed/*",
        "https://www.youtube.com/embed/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "js": [
        "includes/ui.js",
        "includes/common.js",
        "includes/notification.js",
        "includes/purify.min.js",
        "includes/persistent-storage.js",
        "includes/youtube-video-downloader.js",
        "includes/transcript_remix.js",
        "includes/description_inspector.js"
      ],
      "matches": [
        "http://www.youtube.com/*",
        "https://www.youtube.com/*",
        "http://m.youtube.com/*"
      ],
      "exclude_matches": [
        "http://www.youtube.com/embed/*",
        "https://www.youtube.com/embed/*"
      ],
      "run_at": "document_start",
      "css": [
        "includes/youtube-video-downloader.css"
      ]
    },
    {
      "js": [
        "includes/channel_location_content.js"
      ],
      "css": [
        "includes/channel_location_content.css"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ],
      "run_at": "document_start"
    },
    {
      "js": [
        "includes/return_youtube_dislike.js"
      ],
      "matches": [
        "*://youtube.com/*",
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "exclude_matches": [
        "*://*.music.youtube.com/*"
      ],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "options/options.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon.png",
        "icons/16.png",
        "icons/icon64.png",
        "options/options.html",
        "icons/closeBtn.png",
        "includes/progress-display.html",
        "includes/progress-display.js",
        "includes/persistent-storage.js",
        "lib/libav-6.8.8.0-h264-aac-mp3.wasm.wasm",
        "lib/libav-6.8.8.0-h264-aac-mp3.wasm.mjs",
        "includes/hls_worker_v2.js",
        "includes/page_bridge.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "webRequest",
    "declarativeNetRequestWithHostAccess",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Easy Youtube Video Downloader",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon32.png"
    }
  }
}
